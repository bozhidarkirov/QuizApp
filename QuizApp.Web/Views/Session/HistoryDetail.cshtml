@model QuizApp.Web.ViewModels.SessionHistoryDetailViewModel

@{
    ViewData["Title"] = "Класация";
}

<div style="padding: 1.5rem 0;">
    <h2 style="margin-bottom: 0.25rem;">@Model.QuizTitle</h2>
    <p style="color: var(--dt-text-secondary);">
        @(Model.StartedAt?.ToString("dd.MM.yyyy HH:mm")) — @(Model.EndedAt?.ToString("HH:mm"))
    </p>
</div>

@if (!Model.Leaderboard.Any())
{
    <p style="color: var(--dt-text-muted);">Никой не се е присъединил към тази сесия.</p>
}
else
{
    <table class="table table-striped" style="max-width: 480px;">
        <thead>
            <tr>
                <th style="width: 80px;">Позиция</th>
                <th>Участник</th>
                <th style="width: 100px;">Резултат</th>
            </tr>
        </thead>
        <tbody>
            @{
                int position = 1;
            }
            @foreach (var entry in Model.Leaderboard)
            {
                <tr>
                    <td>@position</td>
                    <td>@entry.Nickname</td>
                    <td><span class="badge bg-success">@entry.TotalScore т.</span></td>
                </tr>
                position++;
            }
        </tbody>
    </table>
}

<a asp-action="History" class="btn btn-secondary mt-3">Назад към историята</a>