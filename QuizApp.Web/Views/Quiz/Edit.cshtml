@model QuizApp.Core.Models.Quiz

@{
    ViewData["Title"] = "Редакция на викторина";
}

<div style="padding: 1.5rem 0;">
    <h2 style="margin-bottom: 0.25rem;">@Model.Title</h2>
    <p style="color: var(--dt-text-secondary);">@Model.Description</p>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    @if (Model.IsPublished)
    {
        <span class="badge bg-success">Публикувана</span>
        <form asp-controller="Session" asp-action="Host" asp-route-quizId="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn btn-sm btn-primary">▶ Стартирай Live сесия</button>
        </form>
    }
    else
    {
        <span class="badge bg-secondary">Чернова</span>
        <form asp-action="Publish" asp-route-id="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn btn-sm btn-success">Публикувай</button>
        </form>
    }
</div>

<div class="d-flex justify-content-between align-items-center">
    <h4>Въпроси (@Model.Questions.Count)</h4>
    <a asp-action="AddQuestion" asp-route-quizId="@Model.Id" class="btn btn-sm btn-primary">+ Добави въпрос</a>
</div>

@if (!Model.Questions.Any())
{
    <p class="text-muted">Все още няма добавени въпроси.</p>
}
else
{
    <div class="d-flex flex-column gap-2 mb-3">
        @foreach (var q in Model.Questions.OrderBy(q => q.OrderIndex))
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <strong>@(q.OrderIndex + 1). @q.Text</strong>
                        <form asp-action="DeleteQuestion" asp-route-id="@q.Id" asp-route-quizId="@Model.Id" method="post"
                              onsubmit="return confirm('Изтриване на въпроса?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                        </form>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var a in q.Answers.OrderBy(a => a.OrderIndex))
                        {
                            @if (a.IsCorrect)
                            {
                                <span class="badge bg-success">@a.Text ✓</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@a.Text</span>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<p class="text-muted"><em>Форма за добавяне на въпроси предстои в следващата стъпка.</em></p>

<a asp-action="Index" class="btn btn-secondary">Назад към списъка</a>